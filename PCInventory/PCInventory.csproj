    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  <Version>0.3.0</Version>
  <AssemblyVersion>0.3.0.0</AssemblyVersion>
  <FileVersion>0.3.0.0</FileVersion>
    <AssemblyTitle>PC Inventory Tool</AssemblyTitle>
    <AssemblyDescription>A comprehensive Windows Forms application for gathering and managing PC inventory information with performance optimizations</AssemblyDescription>
    <AssemblyCompany>Gav Cormack</AssemblyCompany>
